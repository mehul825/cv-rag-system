# Environment Settings
PROJECT_NAME="CV RAG System API"
APP_ENV=development
DEBUG=true

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cv_rag
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database URL (using asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cv_rag

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# GPU Serverless / Self-hosted Inference Endpoint
GPU_ENDPOINT_URL=https://router.huggingface.co/v1
GPU_API_KEY=
GPU_MODEL_NAME=google/gemma-3-4b-it

# Cloud Embedding Endpoint
CLOUD_EMBEDDING_URL=https://router.huggingface.co/v1
CLOUD_EMBEDDING_KEY=
CLOUD_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

